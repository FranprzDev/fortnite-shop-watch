{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "tokenharbor": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenHarbor",
      "options": {
        "baseURL": "https://tokenharbor.ai/v1",
        "apiKey": "{env:TOKENHARBOR_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash:free": { "name": "DeepSeek v4.1 Flash (free)" }
      }
    },
    "tokenfactory": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenFactory",
      "options": {
        "baseURL": "https://ultrafast.trytokenfactory.dev/v1",
        "apiKey": "{env:TOKENFACTORY_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash-1017-ultrafast": { "name": "DeepSeek Flash Ultrafast" }
      }
    }
  },
  "model": "tokenharbor/deepseek-v4.1-flash:free"
}
